<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="whollycrypto_payments" resource="default" engine="innodb" comment="Wholly Crypto durable invoice journal">
    <column xsi:type="varchar" name="order_id" length="64" nullable="false" comment="Magento Order Entity ID"/>
    <column xsi:type="varchar" name="invoice_id" length="36" nullable="true" comment="Wholly Invoice UUID"/>
    <column xsi:type="mediumtext" name="record" nullable="false" comment="Verified Payment Journal"/>
    <column xsi:type="datetime" name="updated_at" nullable="false" comment="Last Reconciliation Attempt"/>
    <constraint xsi:type="primary" referenceId="PRIMARY"><column name="order_id"/></constraint>
    <constraint xsi:type="unique" referenceId="WHOLLYCRYPTO_PAYMENTS_INVOICE_ID"><column name="invoice_id"/></constraint>
    <index referenceId="WHOLLYCRYPTO_PAYMENTS_UPDATED_AT" indexType="btree"><column name="updated_at"/><column name="order_id"/></index>
  </table>
</schema>
